# Скопируйте этот файл в .env на рабочем компьютере. .env не попадает в GitHub.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SCRIPT_DEPLOYMENT_ID=AKfycbyzt-aegSnOtNKHveJlIJ-oP3B9I43FXmv6HfSXIFkYYTZMd-9_x4MMC4q3pWEhcBsuPQ

# После успешной контрольной проверки замените false на true.
GOOGLE_WRITES_ENABLED=false

# На каждом компьютере указывается только его рабочая роль: manager или senior.
WORKSTATION_ROLE=
WORKSTATION_ID=
WORKSTATION_LABEL=

# По умолчанию программа доступна только на этом компьютере.
HOST=127.0.0.1
# Обычная установка: workstation. Центральный сервер на компьютере старшего
# механика: central. В режиме central Google OAuth настраивается только здесь.
DEPLOYMENT_MODE=workstation
# Файл с хэшами паролей центральных учётных записей создаёт
# INSTALL-CENTRAL-SERVER.cmd; не добавляйте его в Git и не копируйте.
CENTRAL_ACCOUNTS_PATH=
PORT=4174
